# Whitelist (owner decision 2026-09-25): everything in this folder is private
# unless it is listed below. Work-in-progress documents (RFCs, plans, test
# records, decisions, operating docs) are kept outside this repository.
# Public = finished documents and what builds and checks the library.
/*
!/.gitignore
!/README.md
!/README.ko.md
!/LICENSE
!/CHANGELOG.md
!/Makefile
!/include/
!/src/
!/vendor/
!/tests/
!/examples/
!/manual/
!/manual-ko/
!/screenshots/

# Never public, even inside the directories above.
*_private/
*_internal/
secrets/
.env
.env.*
*.log
*.tmp
.DS_Store
